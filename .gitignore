# ==============================================================================
# Lettore Native — .gitignore
# ==============================================================================

# Swift / Swift Package Manager / Xcode
.build/
.swiftpm/
*.xcodeproj/
*.xcworkspace/
xcuserdata/
*.xcframework/
DerivedData/
.cache/
*.pcm
*.swiftmodule
*.swiftdoc
*.swiftsourceinfo
*.abi.json
*.dSYM/

# App Bundles & Distribution Archives
*.app/
*.zip
*.dmg
*.pkg

# Python / Virtual Environments / Caches
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
ENV/
.env
.env.*
!.env.example
.ruff_cache/
.pytest_cache/
.mypy_cache/
.coverage
htmlcov/
.tox/
*.egg-info/
dist/
build/

# macOS System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
.AppleDouble
.LSOverride
Icon
Icon\r\r

# Editors & Temporary Session Files
.vscode/
.idea/
*.swp
*.swo
*~
*.ses
:memory:.ses
*.sublime-project
*.sublime-workspace

# Audio & Temporary Test Artifacts
*.wav
*.mp3
!assets/audio/*.mp3
!docs/assets/audio/*.mp3
tests/test_output/
backend_tests/test_output/
test_output/
scratch/

# Logs & Diagnostics
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Node / Web
node_modules/
.npm/

# Agent Configuration & Personal Documentation
.agents/
AGENTS.md
dev-docs/
mockup-native-100/
docs/*.md

