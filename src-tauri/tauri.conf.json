{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lettore",
  "version": "0.2.0",
  "identifier": "com.lettore.app",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm --prefix ui run dev",
    "beforeBuildCommand": "npm --prefix ui run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Lettore",
        "width": 420,
        "height": 300,
        "minWidth": 320,
        "minHeight": 180,
        "decorations": false,
        "alwaysOnTop": true,
        "resizable": true,
        "transparent": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src http://127.0.0.1:* http://localhost:*; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png"
    ],
    "externalBin": [
      "binaries/lettore-backend"
    ],
    "macOS": {
      "entitlements": "build/entitlements.mac.plist",
      "minimumSystemVersion": "11.0"
    }
  }
}
